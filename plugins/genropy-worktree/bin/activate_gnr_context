#!/bin/bash
# Activate GenroPy environment for the current worktree.
# Detects worktree from pwd, generates .gnr/ if needed, sets env vars.
#
# Usage: source activate_gnr_context
#        GNR_WT_DB=<base-dbname> source activate_gnr_context
#
# Works for both genropy worktrees (PYTHONPATH + GENRO_GNRFOLDER)
# and client project worktrees (GENRO_GNRFOLDER only).
#
# Each worktree gets its own HTTP port and its own gnrdaemon port, derived
# from the worktree name, so two worktrees of the same project can be served
# at the same time and browsed side by side.

WORKTREE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$WORKTREE_ROOT" ]; then
    echo "Error: not inside a git repository." >&2
    return 1 2>/dev/null || exit 1
fi

MAIN_REPO="$(git worktree list --porcelain | head -1 | sed 's/worktree //')"
if [ "$WORKTREE_ROOT" = "$MAIN_REPO" ]; then
    echo "Error: you are in the main repo, not a worktree." >&2
    return 1 2>/dev/null || exit 1
fi

# System GenroPy config dir: virtualenv installs keep it in
# $VIRTUAL_ENV/etc/gnr/, non-venv installs in ~/.gnr/.
_gnr_config_dir=""
for _gnr_candidate in ${VIRTUAL_ENV:+"$VIRTUAL_ENV/etc/gnr"} "$HOME/.gnr"; do
    if [ -f "$_gnr_candidate/environment.xml" ]; then
        _gnr_config_dir="$_gnr_candidate"
        break
    fi
done
if [ -z "$_gnr_config_dir" ]; then
    echo "Error: environment.xml not found in \$VIRTUAL_ENV/etc/gnr/ or ~/.gnr/" >&2
    return 1 2>/dev/null || exit 1
fi

# Port offset: deterministic from the worktree name, so reopening a terminal
# on the same worktree always gives back the same URL. 1..49, never 0: the
# main repo keeps the standard 8080/40404.
_gnr_offset=$(( $(printf '%s' "$(basename "$WORKTREE_ROOT")" | cksum | cut -d' ' -f1) % 49 + 1 ))
_gnr_http_port=$(( 8080 + _gnr_offset ))
_gnr_daemon_port=$(( 40404 + _gnr_offset ))

# Generate .gnr/ if not present
if [ ! -f "$WORKTREE_ROOT/.gnr/environment.xml" ]; then
    GNR_CONFIG_SRC="$_gnr_config_dir/environment.xml"
    mkdir -p "$WORKTREE_ROOT/.gnr"
    sed -E "s|$MAIN_REPO/|$WORKTREE_ROOT/|g; s|$MAIN_REPO\"|$WORKTREE_ROOT\"|g" \
        "$GNR_CONFIG_SRC" > "$WORKTREE_ROOT/.gnr/environment.xml"
    if [ -d "$_gnr_config_dir/instanceconfig" ] && [ ! -e "$WORKTREE_ROOT/.gnr/instanceconfig" ]; then
        ln -s "$_gnr_config_dir/instanceconfig" "$WORKTREE_ROOT/.gnr/instanceconfig"
    fi
    for entry in ".gnr/"; do
        git -C "$WORKTREE_ROOT" check-ignore -q "$entry" 2>/dev/null || echo "$entry" >> "$WORKTREE_ROOT/.gitignore"
    done
fi

# siteconfig is a real copy, not a symlink: it carries the per-worktree ports.
# Older activations symlinked it — replace those.
if [ -L "$WORKTREE_ROOT/.gnr/siteconfig" ]; then
    rm "$WORKTREE_ROOT/.gnr/siteconfig"
fi
if [ ! -f "$WORKTREE_ROOT/.gnr/siteconfig/default.xml" ]; then
    if [ ! -f "$_gnr_config_dir/siteconfig/default.xml" ]; then
        echo "Error: $_gnr_config_dir/siteconfig/default.xml not found." >&2
        return 1 2>/dev/null || exit 1
    fi
    mkdir -p "$WORKTREE_ROOT/.gnr/siteconfig"
    GNR_WT_SRC="$_gnr_config_dir/siteconfig/default.xml" \
    GNR_WT_DST="$WORKTREE_ROOT/.gnr/siteconfig/default.xml" \
    GNR_WT_HTTP_PORT="$_gnr_http_port" \
    GNR_WT_DAEMON_PORT="$_gnr_daemon_port" \
    python3 - <<'PY'
import os
import xml.etree.ElementTree as ET

tree = ET.parse(os.environ['GNR_WT_SRC'])
root = tree.getroot()

def child(tag):
    node = root.find(tag)
    if node is None:
        node = ET.SubElement(root, tag)
    return node

child('wsgi').set('port', os.environ['GNR_WT_HTTP_PORT'])
daemon = child('gnrdaemon')
daemon.set('host', daemon.get('host') or 'localhost')
daemon.set('port', os.environ['GNR_WT_DAEMON_PORT'])
tree.write(os.environ['GNR_WT_DST'], encoding='unicode', xml_declaration=True)
PY
fi

# The daemon reads its own listening port from environment.xml, not from
# siteconfig (handler.py getFullOptions), so both files must agree or
# `gnr web daemon` binds 40404 while the site looks elsewhere.
GNR_WT_ENV="$WORKTREE_ROOT/.gnr/environment.xml" \
GNR_WT_DAEMON_PORT="$_gnr_daemon_port" \
python3 - <<'PY'
import os
import xml.etree.ElementTree as ET

path = os.environ['GNR_WT_ENV']
tree = ET.parse(path)
root = tree.getroot()
daemon = root.find('gnrdaemon')
if daemon is None:
    daemon = ET.SubElement(root, 'gnrdaemon')
    daemon.set('host', 'localhost')
if daemon.get('port') != os.environ['GNR_WT_DAEMON_PORT']:
    daemon.set('port', os.environ['GNR_WT_DAEMON_PORT'])
    tree.write(path, encoding='unicode', xml_declaration=True)
PY

# Save original values for deactivate_gnr_context
export _GNR_OLD_PYTHONPATH="${PYTHONPATH:-}"
export _GNR_OLD_GENRO_GNRFOLDER="${GENRO_GNRFOLDER:-}"
export _GNR_OLD_GNR_LOCAL_PROJECTS="${GNR_LOCAL_PROJECTS:-}"
export _GNR_OLD_GNR_DB_DSN="${GNR_DB_DSN:-}"
export GENRO_GNRFOLDER="$WORKTREE_ROOT/.gnr"

# Project resolution: GNR_LOCAL_PROJECTS is searched before the paths in
# environment.xml (pathresolver.py:61). It must point at a directory holding
# exactly one project, otherwise the glob `*/instances/<name>` matches sibling
# worktrees too and picks one at random — so give it a private directory with
# a single symlink back to this worktree.
mkdir -p "$WORKTREE_ROOT/.gnr/projects"
if [ ! -L "$WORKTREE_ROOT/.gnr/projects/$(basename "$MAIN_REPO")" ]; then
    ln -sfn "$WORKTREE_ROOT" "$WORKTREE_ROOT/.gnr/projects/$(basename "$MAIN_REPO")"
fi
export GNR_LOCAL_PROJECTS="$WORKTREE_ROOT/.gnr/projects"

# Per-worktree database, opt-in. GNR_WT_DB carries the base db name, because
# the real one lives in the instance's own instanceconfig.xml and is not
# knowable here.
_gnr_db_line="shared (GNR_WT_DB=<dbname> to split it)"
if [ -n "${GNR_WT_DB:-}" ]; then
    if [ "$GNR_WT_DB" = "1" ] || [ "$GNR_WT_DB" = "true" ]; then
        echo "Error: GNR_WT_DB must be the base db name, e.g. GNR_WT_DB=clientepippo" >&2
        return 1 2>/dev/null || exit 1
    fi
    _gnr_branch_slug="$(git -C "$WORKTREE_ROOT" rev-parse --abbrev-ref HEAD |
        tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+|_+$//g' | cut -c1-30)"
    _gnr_wt_dbname="${GNR_WT_DB}_${_gnr_branch_slug}"
    GNR_WT_DBNAME="$_gnr_wt_dbname" \
    GNR_WT_INSTANCECONFIG="$_gnr_config_dir/instanceconfig/default.xml" \
    python3 - <<'PY' > /tmp/gnr_wt_dsn.$$
import os
import xml.etree.ElementTree as ET
from urllib.parse import quote

path = os.environ['GNR_WT_INSTANCECONFIG']
db = ET.parse(path).getroot().find('db')
attrs = db.attrib if db is not None else {}
user = quote(attrs.get('user') or 'postgres')
password = quote(attrs.get('password') or '')
host = attrs.get('host') or 'localhost'
port = attrs.get('port') or '5432'
# The DSN scheme becomes the GenroPy implementation name (gnrapp.dsn_to_config),
# so it is `postgres`, not `postgresql`: the adapter module is gnrpostgres.
print(f"postgres://{user}:{password}@{host}:{port}/{os.environ['GNR_WT_DBNAME']}")
PY
    export GNR_DB_DSN="$(cat /tmp/gnr_wt_dsn.$$)"
    rm -f /tmp/gnr_wt_dsn.$$
    _gnr_db_line="$_gnr_wt_dbname"
fi

# Hand the same environment to Claude Code sessions opened in this worktree.
# Its `env` block in .claude/settings.local.json is applied to every Bash call,
# which a `source` cannot be: each call starts a fresh shell.
GNR_WT_SETTINGS="$WORKTREE_ROOT/.claude/settings.local.json" \
GNR_WT_GNRFOLDER="$GENRO_GNRFOLDER" \
GNR_WT_PROJECTS="$GNR_LOCAL_PROJECTS" \
GNR_WT_DSN="${GNR_DB_DSN:-}" \
GNR_WT_PYPATH="$([ -d "$WORKTREE_ROOT/gnrpy" ] && echo "$WORKTREE_ROOT/gnrpy" || echo '')" \
python3 - <<'PY'
import json
import os
import pathlib

p = pathlib.Path(os.environ['GNR_WT_SETTINGS'])
p.parent.mkdir(parents=True, exist_ok=True)
try:
    data = json.loads(p.read_text())
except (OSError, ValueError):
    data = {}

env = data.setdefault('env', {})
env['GENRO_GNRFOLDER'] = os.environ['GNR_WT_GNRFOLDER']
env['GNR_LOCAL_PROJECTS'] = os.environ['GNR_WT_PROJECTS']
for key, var in (('GNR_DB_DSN', 'GNR_WT_DSN'), ('PYTHONPATH', 'GNR_WT_PYPATH')):
    if os.environ[var]:
        env[key] = os.environ[var]
    else:
        env.pop(key, None)

p.write_text(json.dumps(data, indent=2) + '\n')
PY

if [ -d "$WORKTREE_ROOT/gnrpy" ]; then
    export PYTHONPATH="$WORKTREE_ROOT/gnrpy${PYTHONPATH:+:$PYTHONPATH}"
    echo "GenroPy activated: $WORKTREE_ROOT"
    echo "  PYTHONPATH:      $WORKTREE_ROOT/gnrpy"
else
    echo "GenroPy activated (project): $WORKTREE_ROOT"
fi
echo "  GENRO_GNRFOLDER: $WORKTREE_ROOT/.gnr"
echo "  HTTP:            http://localhost:$_gnr_http_port"
echo "                   http://127.0.0.1:$_gnr_http_port  (same server, different cookie jar)"
echo "  gnrdaemon:       localhost:$_gnr_daemon_port"
echo "  DB:              $_gnr_db_line"
echo "  Claude Code:     env written to .claude/settings.local.json"
if [ -n "${GNR_WT_DB:-}" ]; then
    echo
    echo "  Create it once (main server stopped), then align the schema:"
    echo "    createdb -T $GNR_WT_DB $_gnr_wt_dbname"
    echo "    gnr db setup <instance>"
fi

unset _gnr_offset _gnr_http_port _gnr_daemon_port _gnr_db_line _gnr_branch_slug _gnr_wt_dbname _gnr_config_dir _gnr_candidate
