#!/bin/bash
# Deactivate GenroPy worktree environment.
# Restores PYTHONPATH, GENRO_GNRFOLDER, GNR_LOCAL_PROJECTS and GNR_DB_DSN
# to their previous values.
#
# Usage: source deactivate_gnr_context

if [ -z "${_GNR_OLD_GENRO_GNRFOLDER+x}" ]; then
    echo "Not active."
    return 0 2>/dev/null || exit 0
fi

if [ -n "${_GNR_OLD_PYTHONPATH+x}" ]; then
    if [ -n "$_GNR_OLD_PYTHONPATH" ]; then
        export PYTHONPATH="$_GNR_OLD_PYTHONPATH"
    else
        unset PYTHONPATH
    fi
    unset _GNR_OLD_PYTHONPATH
fi

if [ -n "${_GNR_OLD_GENRO_GNRFOLDER:-}" ]; then
    export GENRO_GNRFOLDER="$_GNR_OLD_GENRO_GNRFOLDER"
else
    unset GENRO_GNRFOLDER
fi
unset _GNR_OLD_GENRO_GNRFOLDER

if [ -n "${_GNR_OLD_GNR_LOCAL_PROJECTS:-}" ]; then
    export GNR_LOCAL_PROJECTS="$_GNR_OLD_GNR_LOCAL_PROJECTS"
else
    unset GNR_LOCAL_PROJECTS
fi
unset _GNR_OLD_GNR_LOCAL_PROJECTS

if [ -n "${_GNR_OLD_GNR_DB_DSN:-}" ]; then
    export GNR_DB_DSN="$_GNR_OLD_GNR_DB_DSN"
else
    unset GNR_DB_DSN
fi
unset _GNR_OLD_GNR_DB_DSN

echo "GenroPy deactivated."
